# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
~$*

# Nothing in assets/ is ignored — the whole point is that the app ships
# fully offline: all text (assets/pages) and all recitations (assets/audio)
# are part of the source tree.

# Self-signed HTTPS certificate — machine-specific, regenerated by quran.sh
cert.pem
key.pem

# Recitations and Quran text are NOT part of the repo (they would add ~1.5 GB).
# Your personal copy keeps them on disk; everyone else downloads them from
# inside the app (Settings → Downloads) or streams from the public APIs.
assets/audio/
assets/pages/

# Local pre-change backups, never shipped
backup-*/

# local test harness
t-*.js

# machine-specific TLS material
rootCA.pem
rootCA-key.pem
rootCA.srl
